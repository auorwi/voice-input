{
  "name": "opentypeless",
  "private": true,
  "version": "1.1.66",
  "type": "module",
  "description": "AI-powered speech-to-text and text polishing desktop app",
  "keywords": [
    "speech-to-text",
    "stt",
    "llm",
    "tauri",
    "desktop",
    "voice-input"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/auorwi/voice-input.git"
  },
  "homepage": "https://github.com/auorwi/voice-input",
  "bugs": {
    "url": "https://github.com/auorwi/voice-input/issues"
  },
  "author": "OpenTypeless Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "signing:setup": "python3 scripts/macos_signing.py setup",
    "signing:status": "python3 scripts/macos_signing.py status",
    "build:mac": "python3 scripts/macos_signing.py build",
    "signing:verify": "python3 scripts/macos_signing.py verify",
    "signing:install": "python3 scripts/macos_signing.py install",
    "test:signing": "python3 -m unittest discover -s scripts/tests -v"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3",
    "@tauri-apps/plugin-deep-link": "^2.4",
    "@tauri-apps/plugin-global-shortcut": "^2.3",
    "@tauri-apps/plugin-opener": "^2.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "better-auth": "1.7.6",
    "framer-motion": "^13.4",
    "i18next": "^26.4",
    "lucide-react": "^1.48",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0",
    "zustand": "^5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "^7.0",
    "@testing-library/react": "^16.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.1",
    "prettier": "^3.5",
    "tailwindcss": "^4.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  }
}
